DATABASE_URL=postgresql://havana:havana@localhost:5432/havana?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DEV_OTP=true
PORT=3000
UPLOAD_DIR=uploads
# Optional: Expo access token if you enable 'enhanced push security' in Expo. RATE_LIMITS=off disables per-user limits (local testing only).
EXPO_ACCESS_TOKEN=
# Production only (Neon): direct, non-pooled connection used for migrations. Optional locally.
DIRECT_URL=
# Cloudflare R2 photo storage. Leave all empty to store photos in UPLOAD_DIR on this machine.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Email login codes via Brevo (free 300/day). OTP_EMAIL_FROM = the sender address verified in Brevo.
BREVO_API_KEY=
OTP_EMAIL_FROM=
# Optional: HTTPS endpoint that sends {type,value,code} (e.g. an SMS gateway). Phone login needs this (or DEV_OTP) to be offered.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
